{
  "name": "chembrain",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "build:portable": "tsc -b && vite build --mode portable --outDir dist-portable && node scripts/package_browser.mjs",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1",
    "build:desktop": "tsc -b && vite build --mode desktop"
  },
  "dependencies": {
    "@rdkit/rdkit": "2026.9.1",
    "@xyflow/react": "12.12.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.8.3",
    "vite": "8.3.4"
  }
}
